---
import { pageNumber } from '../server/pagination';
import ProductLayout from '../layouts/ProductLayout.astro';
import LeaderboardPanel from '../components/LeaderboardPanel.astro';
import { getProfileByUserId } from '../server/profiles';
import { getLatestLeaderboard, getLiveWeek } from '../server/ranking';
import { demoLeaderboard, demoProjects } from '../data/builders-demo';

export const prerender = false;
const currentUser = Astro.locals.user;

const demo = import.meta.env.DEV && Astro.url.searchParams.get('demo') !== '0';
const board = demo ? demoLeaderboard : await Astro.locals.timing.measure('leaderboard', () => getLatestLeaderboard(currentUser?.id, pageNumber(Astro.url.searchParams.get('page'))));
const live = demo ? null : await Astro.locals.timing.measure('live-week', () => getLiveWeek(currentUser?.id));
const currentProfile = currentUser ? await Astro.locals.timing.measure('profile', () => getProfileByUserId(currentUser.id)) : null;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<ProductLayout
  title="Weekly leaderboard - mad.builders"
  description="Every week, builders publish what they shipped and review each other's work. The board is the result."
  active="leaderboard"
  profileHandle={currentProfile?.handle}
  signedIn={Boolean(currentUser)}
>
  <div class="work-page">
    <div class="wrap app-shell">
      {demo && <p class="work-note">Local demo. Fictional projects and sample scores. <a href="/vote?demo=1">Try voting →</a> · <a href="/leaderboard?demo=0">Show real data</a></p>}
      <LeaderboardPanel
        board={board}
        live={live}
        signedIn={Boolean(currentUser)}
        hasProject={Boolean(currentProfile)}
        viewerHandle={currentProfile?.handle}
        demo={demo}
      />
      {demo && demoProjects.map((project) => (
        <article class="result-block" id={project.handle}>
          <h2 class="work-heading">{project.projectName}</h2>
          <p class="work-copy">{project.projectSentence}</p>
          <p class="work-label">This week's goal</p><p class="work-copy">{project.promise}</p>
          <p class="work-label">What changed</p><p class="work-copy">{project.summary}</p>
          <p class="work-label">Feedback wanted</p><p class="work-copy">{project.feedbackRequest}</p>
        </article>
      ))}
    </div>
  </div>
</ProductLayout>
