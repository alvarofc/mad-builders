---
import { Image } from 'astro:assets';
import Layout from '../layouts/ShenzhenLayout.astro';
import { EVENT, APPLY_URL, images, weeks, companies, faqs, marqueePhotos } from '../data/shenzhen';
// the-mu logo for the hero lockup. the-mu = "The Mu" popup-city organiser; its
// logo ships cream-on-transparent, so both marks get a mono ink treatment via CSS.
// mad.builders wordmark is referenced from /public by URL below.
import theMu from '../assets/logos/sisters/the-mu.svg';

// Partner links: mad.builders back to the site home, the-mu to their site.
const MAD_URL = '/';
const THE_MU_URL = 'https://mushanghai.xyz/';

const stamps = ['活', '科', '机', '道'];
const gallery = [
  images.themuStage,
  images.galleryNight,
  images.themuTownhall,
  images.galleryKeynote,
  images.galleryGlove,
  images.themuStageDay,
  ...marqueePhotos,
];

// Photos that open in the lightbox on click (everything except the hero and the
// decorative marquee). Order here = the prev/next order inside the lightbox.
// Indices are wired to each thumbnail via data-zoom-index below.
const zoomPhotos = [
  ...weeks.map((w) => w.img), // 0–3
  images.hackathon, // 4
  images.chinaRobotFull, // 5 — full, uncropped version of the card photo
  images.chinaPanel, // 6
  images.themuBanners, // 7
  ...gallery, // 8+ — marquee photos
];
---

<Layout bodyClass="po" title="mad.sz, un puente con China - mad.builders">
  <header class="po-nav">
    <div class="po-nav-inner">
      <a href="#top" class="po-logo">
        <span>mad.<b>sz</b></span>
      </a>
      <nav>
        <a href="#plan">plan</a>
        <a href="#china">china</a>
        <a href="#the-mu">the-mu</a>
        <a href="#faq">faq</a>
      </nav>
      <a href={APPLY_URL} class="po-nav-cta">Aplicar</a>
    </div>
  </header>

  <div class="po-lang-row">
    <div class="po-lang" role="group" aria-label="Idioma / Language / 语言">
      <button type="button" class="po-lang-btn" data-lang="es" aria-pressed="true">ES</button>
      <button type="button" class="po-lang-btn" data-lang="zh" aria-pressed="false">中文</button>
      <button type="button" class="po-lang-btn" data-lang="en" aria-pressed="false">EN</button>
    </div>
  </div>

  <main id="top">
    <!-- HERO -->
    <section class="po-hero">
      <div class="po-hero-inner">
        <p class="po-eyebrow">
          <a class="po-eyebrow-link" href={MAD_URL} aria-label="mad.builders">
            <img class="po-eyebrow-logo po-eyebrow-logo-mad" src="/logo/mad-builders-green.svg" alt="mad.builders" />
          </a>
          <span class="po-eyebrow-x">×</span>
          <a class="po-eyebrow-link" href={THE_MU_URL} target="_blank" rel="noopener" aria-label="the-mu">
            <img class="po-eyebrow-logo po-eyebrow-logo-mu" src={theMu.src} alt="the-mu" />
          </a>
        </p>
        <h1>mad.<em>sz</em></h1>
        <p class="po-hero-sub">Un mes de inmersión en el ecosistema deep tech y cultural en China.</p>

        <div class="po-stickers">
          <div class="po-stickers-row">
            <span class="po-sticker po-sticker-blue">📍 Shenzhen</span>
            <span class="po-sticker po-sticker-lime">🗓 {EVENT.dateShort}</span>
          </div>
          <div class="po-stickers-row">
            <span class="po-sticker po-sticker-pink">✦ 4 semanas · 10 builders</span>
          </div>
        </div>
      </div>

      <figure class="po-hero-fig">
        <Image
          src={images.hero}
          alt="Escenario al anochecer de muShanghai con un ponente y el público sentado frente a la pantalla"
          widths={[700, 1100, 1600]}
          sizes="(max-width: 900px) 100vw, 46vw"
          loading="eager"
        />
        <span class="po-fig-tag">muShanghai '26</span>
      </figure>
    </section>

    <!-- EL PLAN -->
    <section class="po-section" id="plan">
      <div class="po-h">
        <span class="po-h-stamp">01</span>
        <h2>el plan</h2>
      </div>
      <p class="po-lede">
        Una <mark>popup city de cuatro semanas temáticas</mark> en Shenzhen. Seleccionamos un grupo de
        <mark>10 builders</mark> para acompañarnos.
      </p>

      <div class="po-weeks">
        {
          weeks.map((w, i) => (
            <article class="po-week" style={`--c: ${w.color}`}>
              <div class="po-week-photo po-zoom" data-zoom-index={i}>
                <Image src={w.img} alt={w.alt} widths={[400, 700]} sizes="(max-width: 640px) 100vw, 25vw" style={w.zoom ? `transform: scale(${w.zoom})` : undefined} />
                <span class="po-week-stamp" aria-hidden="true">{stamps[i]}</span>
              </div>
              <div class="po-week-body">
                <span class="po-week-n">semana {w.n}</span>
                <h3>{w.name}</h3>
              </div>
            </article>
          ))
        }
      </div>

      <div class="po-plan-two">
        <div class="po-panel po-panel-cream">
          <h3>Empresas del ecosistema</h3>
          <p>Workshops y visitas con las principales empresas del ecosistema deep tech en China.</p>
          <div class="po-chips">
            {companies.map((c) => <span class="po-chip">{c}</span>)}
            <span class="po-chip po-chip-dash">y más…</span>
          </div>
        </div>
        <div class="po-panel po-panel-photo">
          <Image src={images.hackathon} alt="Equipo ganador de un hackathon en muShanghai posando con su premio y un robot cuadrúpedo" widths={[500, 900]} sizes="(max-width: 900px) 100vw, 44vw" class="po-zoom" data-zoom-index={4} />
          <div class="po-panel-tag">
            <h3>Hackathones + Unconference</h3>
            <p>Construye y comparte tu proyecto.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- POR QUÉ CHINA -->
    <section class="po-china" id="china">
      <div class="po-china-inner">
        <div class="po-china-text">
          <div class="po-h po-h-invert">
            <span class="po-h-stamp">02</span>
            <h2>por qué china</h2>
          </div>
          <p>
            Los <mark>modelos open source</mark> van a tener un papel clave en el futuro de la IA, y la IA física
            como <mark>wearables y robots</mark> está tomando cada vez más protagonismo. China
            lidera en ambos frentes, y en otras áreas del ecosistema deep tech.
          </p>
          <p>
            Pero desde fuera es difícil saber qué está pasando: la barrera del idioma y unas redes propias como WeChat
            hacen que popup cities como muShenzhen sean <mark>la mejor forma de conocer lo que está pasando y
            establecer contactos</mark>.
          </p>
        </div>
        <div class="po-china-photos">
          <figure><Image src={images.chinaRobot} alt="Dos asistentes manejando un robot cuadrúpedo con el móvil en muShanghai" widths={[400, 800]} sizes="(max-width: 900px) 50vw, 22vw" class="po-zoom" data-zoom-index={5} /></figure>
          <figure><Image src={images.chinaPanel} alt="Panel sobre IA física y cadena de suministro" widths={[400, 800]} sizes="(max-width: 900px) 50vw, 22vw" class="po-zoom" data-zoom-index={6} /></figure>
        </div>
      </div>
    </section>

    <!-- THEMU -->
    <section class="po-section" id="the-mu">
      <div class="po-h">
        <span class="po-h-stamp">03</span>
        <h2>the-mu</h2>
      </div>
      <div class="po-themu">
        <div class="po-panel po-panel-cream po-themu-text">
          <p>
            Nuestros amigos de <a class="po-inline-link" href={THE_MU_URL} target="_blank" rel="noopener">the-mu</a>
            llevan años organizando popup cities por todo el mundo. El último evento, <mark>muShanghai</mark>, fue un éxito, con la participación
            de empresas como z.ai, Unitree o NIO.
          </p>
          <p>
            Desde <a class="po-inline-link" href={MAD_URL}><mark>mad.builders</mark></a> organizamos un grupo para llevar
            a builders desde España a la próxima edición, en Shenzhen.
          </p>
        </div>
        <figure class="po-themu-fig">
          <Image src={images.themuBanners} alt="Banners de las semanas temáticas de muShanghai" widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 52vw" class="po-zoom" data-zoom-index={7} />
        </figure>
      </div>
    </section>

    <!-- marquee -->
    <div class="po-marquee" aria-hidden="true">
      <div class="po-marquee-track" style={`animation-duration: ${gallery.length * 9}s`}>
        {[...gallery, ...gallery].map((g, i) => (
          <Image src={g} alt="" widths={[440]} sizes="340px" class="po-marquee-img po-zoom" data-zoom-index={8 + (i % gallery.length)} />
        ))}
      </div>
    </div>

    <!-- FAQ -->
    <section class="po-section po-faq-section" id="faq">
      <div class="po-h">
        <span class="po-h-stamp">04</span>
        <h2>faq</h2>
      </div>
      <div class="po-faq">
        {
          faqs.map((f) => (
            <details class="po-faq-item">
              <summary>
                {f.q}
                <span class="po-faq-plus" aria-hidden="true">+</span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- APLICACIONES -->
    <section class="po-apply" id="aplicaciones">
      <div class="po-apply-stamps" aria-hidden="true">
        {stamps.map((s) => <span>{s}</span>)}
      </div>
      <h2>¿Te vienes a<br />Shenzhen<em>?</em></h2>
      <p>Cuatro semanas en el corazón de la tecnología en China.</p>
      <div class="po-apply-cta">
        <span class="po-btn po-btn-light po-btn-disabled" aria-disabled="true" data-i18n="applyBtn">Aplicar ahora →</span>
        <span class="po-btn po-btn-ghost-light po-btn-disabled" aria-disabled="true" data-i18n="sponsorBtn">Info para sponsors</span>
      </div>
    </section>
  </main>

  <footer class="po-footer">
    <span>mad.<b>sz</b></span>
    <p>Organizado por <a class="po-inline-link" href={MAD_URL}>mad.builders</a> × <a class="po-inline-link" href={THE_MU_URL} target="_blank" rel="noopener">the-mu</a></p>
  </footer>

  <!-- click-to-zoom lightbox for the content photos -->
  <dialog id="po-lightbox" class="po-lightbox">
    <button id="po-lb-close" class="po-lb-btn po-lb-close" aria-label="Cerrar">✕</button>
    <button id="po-lb-prev" class="po-lb-btn" aria-label="Anterior">←</button>
    <div class="po-lb-stage">
      {zoomPhotos.map((p, i) => (
        <Image src={p} alt="" widths={[800, 1400, 2000]} sizes="90vw" class="po-lb-img" data-index={i} loading="lazy" />
      ))}
    </div>
    <button id="po-lb-next" class="po-lb-btn" aria-label="Siguiente">→</button>
  </dialog>
</Layout>

<script>
  const dialog = document.getElementById('po-lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const imgs = [...dialog.querySelectorAll<HTMLImageElement>('.po-lb-img')];
    let current = 0;

    const show = (i: number) => {
      current = (i + imgs.length) % imgs.length;
      imgs.forEach((img, j) => (img.style.display = j === current ? 'block' : 'none'));
    };

    document.querySelectorAll<HTMLElement>('[data-zoom-index]').forEach((el) => {
      el.addEventListener('click', () => {
        show(Number(el.dataset.zoomIndex));
        dialog.showModal();
      });
    });

    (document.getElementById('po-lb-close') as HTMLButtonElement).addEventListener('click', () => dialog.close());
    (document.getElementById('po-lb-prev') as HTMLButtonElement).addEventListener('click', () => show(current - 1));
    (document.getElementById('po-lb-next') as HTMLButtonElement).addEventListener('click', () => show(current + 1));
    // click on the backdrop (outside the image/buttons) closes
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>

<script>
  // Client-side language switch. The page ships in Spanish; the switch swaps
  // every text node to EN / ZH and remembers the choice. Rich strings (marks,
  // links) are stored as HTML. Spanish is captured from the DOM on load.
  {
    const $ = (s: string) => document.querySelector(s) as HTMLElement | null;
    const $$ = (s: string) => [...document.querySelectorAll<HTMLElement>(s)];

    const navLinks = $$('.po-nav nav a');
    const cta = $('.po-nav-cta');
    const heroSub = $('.po-hero-sub');
    const stBlue = $('.po-sticker-blue');
    const stLime = $('.po-sticker-lime');
    const stPink = $('.po-sticker-pink');
    const planH = $('#plan .po-h h2');
    const lede = $('.po-lede');
    const compH = $('#plan .po-panel-cream h3');
    const compP = $('#plan .po-panel-cream p');
    const chipMore = $('.po-chip-dash');
    const hackH = $('.po-panel-tag h3');
    const hackP = $('.po-panel-tag p');
    const chinaH = $('#china .po-h h2');
    const chinaPs = $$('#china .po-china-text p');
    const themuPs = $$('#the-mu .po-themu-text p');
    const faqH = $('#faq .po-h h2');
    const faqSummaries = $$('#faq .po-faq-item summary');
    const faqAnswers = $$('#faq .po-faq-item p');
    const applyH = $('.po-apply h2');
    const applyP = $('.po-apply > p');
    const applyBtn = $('[data-i18n="applyBtn"]');
    const sponsorBtn = $('[data-i18n="sponsorBtn"]');
    const footer = $('.po-footer p');
    const weekNames = $$('.po-week-body h3');
    const weekLabels = $$('.po-week-n');
    const langBtns = $$('.po-lang-btn');

    // link snippets reused inside rich strings
    const MU = `<a class="po-inline-link" href="https://mushanghai.xyz/" target="_blank" rel="noopener">the-mu</a>`;
    const MAD = `<a class="po-inline-link" href="/">mad.builders</a>`;
    const MADM = `<a class="po-inline-link" href="/"><mark>mad.builders</mark></a>`;

    const T: Record<string, any> = {
      en: {
        navPlan: 'plan', navChina: 'china', navFaq: 'faq', navCta: 'Apply',
        heroSub: `A month immersed in China's deep tech and cultural ecosystem.`,
        stShenzhen: '📍 Shenzhen', stDate: '🗓 November 2026', stWeeks: '✦ 4 weeks · 10 builders',
        planH: 'the plan',
        lede: `A <mark>four-week themed popup city</mark> in Shenzhen. We're selecting a group of <mark>10 builders</mark> to join us.`,
        compH: 'Ecosystem companies',
        compP: `Workshops and visits with the leading companies in China's deep tech ecosystem.`,
        chipMore: 'and more…',
        hackH: 'Hackathons + Unconference', hackP: 'Build and share your project.',
        chinaH: 'why china',
        chinaP1: `<mark>Open source models</mark> will play a key role in the future of AI, and physical AI like <mark>wearables and robots</mark> is taking center stage. China leads on both fronts, and across other areas of the deep tech ecosystem.`,
        chinaP2: `But from the outside it's hard to know what's going on: the language barrier and homegrown networks like WeChat make popup cities like muShenzhen <mark>the best way to see what's happening and make connections</mark>.`,
        themuP1: `Our friends at ${MU} have spent years running popup cities around the world. Their last event, <mark>muShanghai</mark>, was a hit, with companies like z.ai, Unitree and NIO taking part.`,
        themuP2: `From ${MADM} we're putting together a group to bring builders from Spain to the next edition, in Shenzhen.`,
        faqH: 'faq',
        faqQ: ['Who is it for?', 'What does it cost?', 'Do I have to attend the whole month?', `What's day-to-day like?`, 'Can I work from there?'],
        faqA: [
          'Anyone eager to build and share. We believe a diverse group makes the experience richer, so we select candidates for a mix of ages, backgrounds and disciplines.',
          `Flights are around €800, and the full month's stay runs from €1,000 to €2,000 depending on the accommodation. We're in talks with sponsors to help cover part of the group's costs.`,
          `Not required: we'll consider applications from builders who can only attend part of the month.`,
          `Mostly we'll share a space, but the format is open: everyone sets their own agenda, joining whichever of each day's scheduled events interest them.`,
          `Yes. the-mu has made this one of the first events in China with open internet access. So from the venue you'll reach every network and service openly, no VPN needed.`,
        ],
        applyH: `Coming to<br />Shenzhen<em>?</em>`,
        applyP: `Four weeks at the heart of China's tech scene.`,
        applyBtn: 'Apply now →', sponsorBtn: 'Sponsor info',
        footer: `Organised by ${MAD} × ${MU}`,
        weekLabel: ['week 01', 'week 02', 'week 03', 'week 04'],
      },
      zh: {
        navPlan: '计划', navChina: '中国', navFaq: '问答', navCta: '申请',
        heroSub: '在中国硬科技与文化生态中沉浸一个月。',
        stShenzhen: '📍 深圳', stDate: '🗓 2026 年 11 月', stWeeks: '✦ 4 周 · 10 位 builders',
        planH: '计划',
        lede: '深圳一场<mark>为期四周的主题城市快闪</mark>。我们将精选 <mark>10 位 builders</mark> 与我们同行。',
        compH: '生态企业',
        compP: '与中国硬科技生态中的头部企业进行工作坊与实地走访。',
        chipMore: '以及更多…',
        hackH: '黑客松 + Unconference', hackP: '打造并分享你的项目。',
        chinaH: '为什么中国',
        chinaP1: '<mark>开源模型</mark>将在 AI 的未来中扮演关键角色，而<mark>可穿戴设备与机器人</mark>等物理 AI 也日益成为焦点。中国在这两方面，以及硬科技生态的其他领域，都处于领先地位。',
        chinaP2: '但从外部很难了解正在发生什么：语言障碍以及微信等本土网络，使得像 muShenzhen 这样的城市快闪成为<mark>了解真实动态、建立人脉的最佳方式</mark>。',
        themuP1: `我们的朋友 ${MU} 多年来在世界各地举办城市快闪。上一场活动 <mark>muShanghai</mark> 大获成功，z.ai、Unitree、NIO 等企业均有参与。`,
        themuP2: `我们 ${MADM} 正在组织一支队伍，把来自西班牙的 builders 带到下一届——深圳。`,
        faqH: '问答',
        faqQ: ['适合谁参加？', '费用是多少？', '必须参加整个月吗？', '日常是怎样的？', '可以在那里工作吗？'],
        faqA: [
          '任何渴望创造与分享的人。我们相信多元的群体会让体验更丰富，因此在选拔时会兼顾不同年龄、背景与专业。',
          '机票约 800 欧元，整月住宿视住宿类型而定，约 1000 至 2000 欧元。我们正在与赞助商洽谈，以覆盖团队的部分费用。',
          '并非必须：我们也会考虑只能参加部分时间的 builders 的申请。',
          '我们主要会共享同一个空间，但形式自由：每个人自行安排日程，参加当天感兴趣的活动。',
          '可以。the-mu 让这成为中国最早提供开放互联网访问的活动之一。因此在场地内你无需 VPN 即可自由访问所有网络与服务。',
        ],
        applyH: `要来<br />深圳<em>吗？</em>`,
        applyP: '四周时间，置身中国科技的核心。',
        applyBtn: '立即申请 →', sponsorBtn: '赞助信息',
        footer: `由 ${MAD} × ${MU} 主办`,
        weekNames: ['AI', '生物科技与长寿', '机器人与硬件', '文化'],
        weekLabel: ['第 01 周', '第 02 周', '第 03 周', '第 04 周'],
      },
    };

    // capture Spanish from the DOM
    T.es = {
      navPlan: navLinks[0]?.innerHTML, navChina: navLinks[1]?.innerHTML, navFaq: navLinks[3]?.innerHTML,
      navCta: cta?.innerHTML, heroSub: heroSub?.innerHTML,
      stShenzhen: stBlue?.innerHTML, stDate: stLime?.innerHTML, stWeeks: stPink?.innerHTML,
      planH: planH?.innerHTML, lede: lede?.innerHTML, compH: compH?.innerHTML, compP: compP?.innerHTML,
      chipMore: chipMore?.innerHTML, hackH: hackH?.innerHTML, hackP: hackP?.innerHTML,
      chinaH: chinaH?.innerHTML, chinaP1: chinaPs[0]?.innerHTML, chinaP2: chinaPs[1]?.innerHTML,
      themuP1: themuPs[0]?.innerHTML, themuP2: themuPs[1]?.innerHTML,
      faqH: faqH?.innerHTML,
      faqQ: faqSummaries.map((s) => s.childNodes[0]?.nodeValue ?? ''),
      faqA: faqAnswers.map((p) => p.innerHTML),
      applyH: applyH?.innerHTML, applyP: applyP?.innerHTML,
      applyBtn: applyBtn?.innerHTML, sponsorBtn: sponsorBtn?.innerHTML, footer: footer?.innerHTML,
      weekNames: weekNames.map((h) => h.innerHTML), weekLabel: weekLabels.map((l) => l.innerHTML),
    };

    const setHTML = (el: HTMLElement | null, v: any) => { if (el && v != null) el.innerHTML = v; };

    const render = (lang: string) => {
      const d = Object.assign({}, T.es, T[lang] || {});
      setHTML(navLinks[0], d.navPlan); setHTML(navLinks[1], d.navChina); setHTML(navLinks[3], d.navFaq);
      setHTML(cta, d.navCta); setHTML(heroSub, d.heroSub);
      setHTML(stBlue, d.stShenzhen); setHTML(stLime, d.stDate); setHTML(stPink, d.stWeeks);
      setHTML(planH, d.planH); setHTML(lede, d.lede); setHTML(compH, d.compH); setHTML(compP, d.compP);
      setHTML(chipMore, d.chipMore); setHTML(hackH, d.hackH); setHTML(hackP, d.hackP);
      setHTML(chinaH, d.chinaH); setHTML(chinaPs[0], d.chinaP1); setHTML(chinaPs[1], d.chinaP2);
      setHTML(themuPs[0], d.themuP1); setHTML(themuPs[1], d.themuP2);
      setHTML(faqH, d.faqH);
      faqSummaries.forEach((s, i) => { if (s.childNodes[0]) s.childNodes[0].nodeValue = d.faqQ[i]; });
      faqAnswers.forEach((p, i) => setHTML(p, d.faqA[i]));
      setHTML(applyH, d.applyH); setHTML(applyP, d.applyP);
      setHTML(applyBtn, d.applyBtn); setHTML(sponsorBtn, d.sponsorBtn); setHTML(footer, d.footer);
      weekNames.forEach((h, i) => setHTML(h, d.weekNames[i]));
      weekLabels.forEach((l, i) => setHTML(l, d.weekLabel[i]));
      document.documentElement.lang = lang;
      langBtns.forEach((b) => {
        const isActive = b.dataset.lang === lang;
        b.classList.toggle('active', isActive);
        b.setAttribute('aria-pressed', String(isActive));
      });
      try { localStorage.setItem('sz-lang', lang); } catch {}
    };

    langBtns.forEach((b) => b.addEventListener('click', () => render(b.dataset.lang!)));

    let saved = 'es';
    try { saved = localStorage.getItem('sz-lang') || 'es'; } catch {}
    render(saved);
  }
</script>

