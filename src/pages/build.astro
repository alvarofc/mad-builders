---
import ProductLayout from '../layouts/ProductLayout.astro';
import ShareButton from '../components/ShareButton.astro';
import { authConfigured } from '../server/auth';
import { getProfileByUserId, normalizeHandle, validHandle } from '../server/profiles';
import WeeklyUpdateForm from '../components/WeeklyUpdateForm';
import { projectStages } from '../server/results';
import { getBuildState, madridDate } from '../server/weeks';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const currentUser = Astro.locals.user;
const currentProfile = currentUser ? await getProfileByUserId(currentUser.id) : null;
const selectedWeekDate = Astro.url.searchParams.get('week');
const buildState = currentProfile ? await getBuildState(currentProfile.userId, selectedWeekDate) : null;
const unavailableWeek = Boolean(currentProfile && selectedWeekDate && !buildState);
if (unavailableWeek) Astro.response.status = 404;
const ref = normalizeHandle(Astro.url.searchParams.get('ref') ?? '');
const safeRef = validHandle(ref) ? ref : '';
const editing = Astro.url.searchParams.has('edit') && buildState?.phase === 'active';
---

<ProductLayout
  title="Proof of work - mad.builders"
  description="Make a weekly promise, publish what shipped, and build a public record of your work."
  active="build"
  profileHandle={currentProfile?.handle}
  signedIn={Boolean(currentUser)}
>
  <div class="work-page">
    <div class="wrap app-shell">
      <div class="app-context mono">
        <span>mad builders / weekly proof of work</span>
        <div class="app-context-actions">
          {currentProfile && <a href={`/builders/${currentProfile.handle}`}>{currentProfile.projectName} →</a>}
          <a href="/leaderboard">leaderboard →</a>
        </div>
      </div>
    </div>

    <section class="week-section" id="this-week">
      <div class="wrap section-heading">
        <p class="work-label">accountability loop</p>
        <h1 class="app-section-title">{buildState?.selectedLateWeek ? 'Catch up' : 'This week'}</h1>
      </div>
      <div class="wrap update-shell">
        <div>
        {!authConfigured ? (
          <>
            <h2 class="work-heading">The build log is offline.</h2>
            <p class="work-copy">The database and GitHub sign-in still need their deployment credentials.</p>
          </>
        ) : !currentUser ? (
          <>
            <p class="work-label">step 01</p>
            <h2 class="work-heading">Start with GitHub.</h2>
            <p class="work-copy">
              GitHub gives each builder one identity and lets us match public commit links to the account that signed in.
            </p>
            <button
              class="work-button"
              type="button"
              data-github-sign-in
              data-callback={safeRef ? `/build?ref=${safeRef}` : '/build'}
            >
              continue with GitHub
            </button>
            <p class="work-status" data-auth-status aria-live="polite"></p>
          </>
        ) : !currentProfile ? (
          <>
            <p class="work-label">step 02 / add your project</p>
            <h2 class="work-heading">What are you building?</h2>
            <p class="work-copy">Keep it plain. You can make it prettier after you've shipped something.</p>
            <form class="work-form" method="post" action="/api/profile" data-api-form>
              <input type="hidden" name="ref" value={safeRef} />
              <label class="work-field">
                <span>your name</span>
                <input
                  name="displayName"
                  value={currentUser.name}
                  minlength="2"
                  maxlength="80"
                  autocomplete="name"
                  required
                />
              </label>
              <label class="work-field">
                <span>public handle</span>
                <input
                  name="handle"
                  placeholder="ana-builds"
                  minlength="3"
                  maxlength="30"
                  pattern="[a-z0-9][a-z0-9-]{1,28}[a-z0-9]"
                  autocapitalize="none"
                  autocomplete="off"
                  required
                />
                <small>mad.builders/builders/your-handle</small>
              </label>
              <label class="work-field">
                <span>location</span>
                <input name="location" placeholder="Madrid" maxlength="80" autocomplete="address-level2" />
              </label>
              <label class="work-field">
                <span>project</span>
                <input name="projectName" placeholder="What has your attention?" minlength="2" maxlength="100" required />
              </label>
              <label class="work-field">
                <span>project URL</span>
                <input name="projectUrl" type="url" placeholder="https://" inputmode="url" />
              </label>
              <label class="work-field">
                <span>What are you building in a sentence?</span>
                <textarea name="bio" minlength="5" maxlength="280" required></textarea>
              </label>
              <div>
                <button class="work-button" type="submit">publish project</button>
                <p class="work-status" data-form-status aria-live="polite"></p>
              </div>
            </form>
          </>
        ) : unavailableWeek ? (
          <p class="work-copy">This update is unavailable or already published. <a href="/build#this-week">Back to this week</a></p>
        ) : (
          <>
            {buildState?.selectedLateWeek ? (
              <p class="work-note"><a href="/build#this-week">Back to this week</a></p>
            ) : buildState?.unfinishedWeeks.length ? (
              <p class="work-note">Still want to share an earlier week? {buildState.unfinishedWeeks.map((week) => (
                <a href={`/build?week=${week.weekStartDate}#this-week`}>Finish the update for {week.weekStartDate}. </a>
              ))}</p>
            ) : null}
            {buildState?.currentResult && !editing ? (
              <>
                <p class="work-label">published / week of {buildState.currentWeek?.weekStartDate}</p>
                <h2 class="work-heading">Your week is published.</h2>
                <p class="work-copy update-copy">{buildState.currentResult.summary}</p>
                {buildState.nextCommitment && <p class="work-copy">Next week: {buildState.nextCommitment.promise}</p>}
                <p class="work-note">{buildState.phase === 'active' ? `You can edit until voting opens ${madridDate(buildState.currentWeek!.submissionClosesAt)}.` : 'Voting is open. Your update is locked for fair comparisons.'}</p>
                <div class="work-actions">
                  <ShareButton path={`/builders/${currentProfile.handle}/weeks/${buildState.currentWeek?.weekStartDate}?ref=${currentProfile.handle}`} title={[`Weekly update · week of ${buildState.currentWeek?.weekStartDate}\n\nThis week I worked on ${currentProfile.projectName}:\n${buildState.currentResult.summary}`, buildState.currentResult.feedbackRequest].filter(Boolean).join("\n\n")} expanded eventName="weekly_result_shared" handle={currentProfile.handle} />
                  {buildState.phase === 'active' && <a class="work-button secondary" href="/build?edit#this-week">edit update</a>}
                  {buildState.phase === 'voting' && <a class="work-button" href="/vote">review ten pairs</a>}
                  <a
                    class={`work-button ${buildState.phase === 'voting' ? 'secondary' : ''}`}
                    href={`/builders/${currentProfile.handle}/weeks/${buildState.currentWeek?.weekStartDate}`}
                  >
                    open the result
                  </a>
                </div>
                {buildState.canSetNextPromise && buildState.nextWeek && (
                  <details class="result-block" data-next-commitment-editor>
                    <summary>Edit next week's goals</summary>
                    <p class="work-note">Goals lock {madridDate(buildState.nextWeek.startsAt)}. Your published update stays unchanged.</p>
                    <form class="work-form" method="post" action="/api/commitment" data-api-form>
                      <input type="hidden" name="weekId" value={buildState.nextWeek.id} />
                      <label class="work-field">
                        <span>What do you want to have done by the end of next week?</span>
                        <textarea name="promise" minlength="5" maxlength="280" required>{buildState.nextCommitment?.promise}</textarea>
                      </label>
                      <div>
                        <button class="work-button" type="submit">save my commitment</button>
                        <p class="work-status" data-form-status aria-live="polite"></p>
                      </div>
                    </form>
                  </details>
                )}
              </>
            ) : buildState?.currentCommitment || (buildState?.currentWeek && buildState.phase === 'active') ? (
              <>
                <p class="work-label">weekly update / week of {buildState.currentWeek?.weekStartDate}</p>
                <h2 class="work-heading">{editing ? 'Edit your weekly update.' : buildState.currentCommitment?.promise ? 'Tell us how the week went.' : 'Your first weekly update.'}</h2>
                {buildState.currentWeek && (
                  <p class="work-note">{buildState.late ? 'The ranking deadline has passed. You can still publish this update, but it will not enter voting or count toward your streak.' : `Ranking deadline: ${madridDate(buildState.currentWeek.submissionClosesAt)}`}</p>
                )}
                <WeeklyUpdateForm
                  client:load
                  draftKey={`weekly:${currentProfile.userId}:${buildState.currentWeek?.id}`}
                  commitmentId={buildState.currentCommitment?.id}
                  weekId={buildState.currentWeek?.id}
                  promise={buildState.currentCommitment?.promise}
                  canSetNextPromise={buildState.canSetNextPromise}
                  editing={editing}
                  late={buildState.late}
                  stages={projectStages}
                  initialValues={{
                    projectSentence: buildState.currentResult?.projectSentence ?? currentProfile.bio,
                    summary: buildState.currentResult?.summary ?? '',
                    status: buildState.currentResult?.status ?? '',
                    nextPromise: buildState.nextCommitment?.promise ?? '',
                    feedbackRequest: buildState.currentResult?.feedbackRequest ?? '',
                    projectUrl: currentProfile.projectUrl ?? '',
                    projectStage: currentProfile.projectStage ?? projectStages[0].value,
                    proofUrl: buildState.currentResult?.proofUrl ?? '',
                  }}
                />
              </>
            ) : buildState?.nextWeek ? (
              <>
                <p class="work-label">next week / starts {madridDate(buildState.nextWeek.startsAt)}</p>
                <h2 class="work-heading">What do you want to have done by the end of next week?</h2>
                <p class="work-copy">Set clear goals that another builder can judge as complete or incomplete.</p>
                <form class="work-form" method="post" action="/api/commitment" data-api-form>
                  <input type="hidden" name="weekId" value={buildState.nextWeek.id} />
                  <label class="work-field">
                    <span>next week's goals</span>
                    <textarea
                      name="promise"
                      minlength="5"
                      maxlength="280"
                      required
                    >{buildState.nextCommitment?.promise}</textarea>
                  </label>
                  <div>
                    <button class="work-button" type="submit">save my commitment</button>
                    <p class="work-status" data-form-status aria-live="polite"></p>
                  </div>
                </form>
              </>
            ) : (
              <>
                <p class="work-label">your project is live</p>
                <h2 class="work-heading">Good. Now there's somewhere to put the work.</h2>
                <p class="work-copy">The next weekly cycle has not been scheduled yet. Your project page is ready to share.</p>
                <div class="work-actions">
                  <a class="work-button" href={`/builders/${currentProfile.handle}`}>open my project</a>
                  <a class="work-button secondary" href="/builders">see the projects</a>
                </div>
              </>
            )}
          </>
        )}
        </div>
      </div>
    </section>
  </div>
</ProductLayout>

<script>
  import { createAuthClient } from 'better-auth/client';
  import { submitApiForm } from '../scripts/submit-api-form';

  const signInButton = document.querySelector<HTMLButtonElement>('[data-github-sign-in]');
  const authStatus = document.querySelector<HTMLElement>('[data-auth-status]');

  signInButton?.addEventListener('click', async () => {
    signInButton.disabled = true;
    if (authStatus) authStatus.textContent = 'Opening GitHub...';

    try {
      const authClient = createAuthClient();
      const { error } = await authClient.signIn.social({
        provider: 'github',
        callbackURL: signInButton.dataset.callback || '/build',
      });
      if (error) throw error;
    } catch {
      signInButton.disabled = false;
      if (authStatus) authStatus.textContent = 'GitHub sign-in failed. Try again.';
    }
  });

  document.querySelectorAll<HTMLFormElement>('[data-api-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      await submitApiForm(form);
    });
  });
</script>
