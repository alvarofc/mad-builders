---
import ProductLayout from '../layouts/ProductLayout.astro';
import ShareButton from '../components/ShareButton.astro';
import { getProjectInvite, listOwnedProjects } from '../server/projects';
import { authConfigured } from '../server/auth';
import { getProfileByUserId, normalizeHandle, validHandle } from '../server/profiles';
import { blocksWeeklyUpdate, getReviewState } from '../server/ranking';
import WeeklyUpdateChat from '../components/WeeklyUpdateChat';
import { projectStages } from '../server/results';
import { getBuildState, madridDate } from '../server/weeks';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const inviteToken = Astro.url.searchParams.get('invite') ?? '';
const invitation = inviteToken ? await getProjectInvite(inviteToken) : null;
if (inviteToken) Astro.response.headers.set('Referrer-Policy', 'strict-origin');
const currentUser = Astro.locals.user;
const currentProfile = currentUser ? await Astro.locals.timing.measure('profile', () => getProfileByUserId(currentUser.id)) : null;
const ownedProjects = currentUser ? await listOwnedProjects(currentUser.id) : [];
const selectedWeekDate = Astro.url.searchParams.get('week');
const buildState = currentProfile ? await Astro.locals.timing.measure('build_state', () => getBuildState(currentProfile.id, selectedWeekDate)) : null;
const review = currentProfile && buildState?.currentWeek ? await Astro.locals.timing.measure('review', () => getReviewState(currentUser!.id)) : null;
const votingRequired = review && buildState?.currentWeek && blocksWeeklyUpdate(review, buildState.currentWeek.startsAt, buildState.now);
const unavailableWeek = Boolean(currentProfile && selectedWeekDate && !buildState);
if (unavailableWeek) Astro.response.status = 404;
const ref = normalizeHandle(Astro.url.searchParams.get('ref') ?? '');
const safeRef = validHandle(ref) ? ref : '';
const editing = Astro.url.searchParams.has('edit') && buildState?.phase === 'active';
const askedToJoin = Astro.url.searchParams.has('join') || Astro.url.searchParams.has('requested');
---

<ProductLayout
  title="Proof of work - mad.builders"
  description="Set a weekly goal, publish what shipped, and build a public record of your work."
  active="build"
  noindex={Boolean(inviteToken)}
  profileHandle={currentProfile?.handle}
  signedIn={Boolean(currentUser)}
>
  <div class="work-page">
    {/* the product nav one row up already links the project and the board, and
        names the place. this strip and its kicker only repeated it. */}
    <section class="week-section" id="this-week">
      <div class="wrap section-heading">
        <h1 class="app-section-title">{buildState?.selectedLateWeek ? 'Catch up' : 'This week'}</h1>
      </div>
      <div class="wrap update-shell">
        <div>
        {inviteToken && (
          <div class="result-block">
            {invitation ? <>
              <h2 class="work-heading">You’re invited to {invitation.name}.</h2>
              <p class="work-copy">Join as a co-owner to edit the project, publish shared updates, and invite teammates.</p>
              {currentUser ? (
                <form method="post" action="/api/project">
                  <input type="hidden" name="token" value={inviteToken} />
                  <button class="work-button" name="action" value="accept-invite">accept invitation</button>
                </form>
              ) : <p class="work-note">Sign in below to accept your invitation.</p>}
            </> : <p class="work-copy">This invite has expired, been revoked, or already been used. Ask the owner for a new link.</p>}
          </div>
        )}
        {/* only for builders who are not in a project yet. members reach it via
            /build?join= or an invite link, so it stays out of the update flow. */}
        {currentUser && (!ownedProjects.length || askedToJoin) && (
          <details class="result-block" id="join-project" open={askedToJoin}>
            <summary>Join an existing project</summary>
            <p class="work-note">Request co-ownership using its project handle. An existing owner approves requests in settings. Once approved, reload this page and choose the shared project.</p>
            {Astro.url.searchParams.has('requested') && <p class="work-copy" role="status">Request sent. Ask your teammate to approve it in settings.</p>}
            <form class="work-form" method="post" action="/api/project">
              <input type="hidden" name="action" value="request" />
              <label class="work-field"><span>project handle</span><input name="handle" minlength="3" maxlength="30" placeholder="your-project" required /></label>
              <button class="work-button secondary" type="submit">request co-ownership</button>
            </form>
          </details>
        )}
        {ownedProjects.length > 1 && (
          <form class="work-form" method="post" action="/api/project">
            <input type="hidden" name="action" value="switch" />
            <label class="work-field"><span>active project</span>
              <select name="projectId">{ownedProjects.map((entry) => <option value={entry.id} selected={entry.active}>{entry.name}</option>)}</select>
            </label>
            <button class="work-button secondary" type="submit">switch project</button>
          </form>
        )}
        {!authConfigured ? (
          <>
            <h2 class="work-heading">Publishing is offline.</h2>
            <p class="work-copy">The database and GitHub sign-in still need their deployment credentials.</p>
          </>
        ) : !currentUser ? (
          <>
            <p class="work-label">step 01</p>
            <h2 class="work-heading">Start with GitHub.</h2>
            <p class="work-copy">
              GitHub gives each builder one identity and lets us match public commit links to the account that signed in.
            </p>
            <button
              class="work-button"
              type="button"
              data-github-sign-in
              data-callback={invitation ? `/build?invite=${inviteToken}` : safeRef ? `/build?ref=${safeRef}` : '/build'}
            >
              continue with GitHub
            </button>
            <p class="work-status" data-auth-status aria-live="polite"></p>
          </>
        ) : !currentProfile ? (
          <>
            <p class="work-label">step 02 / add your project</p>
            <h2 class="work-heading">What are you building?</h2>
            <p class="work-copy">Keep it plain. You can make it prettier after you've shipped something.</p>
            <form class="work-form" method="post" action="/api/profile" enctype="multipart/form-data" data-api-form>
              <input type="hidden" name="ref" value={safeRef} />
              <label class="work-field">
                <span>your name</span>
                <input
                  name="displayName"
                  value={currentUser.name}
                  minlength="2"
                  maxlength="80"
                  autocomplete="name"
                  required
                />
              </label>
              <label class="work-field">
                <span>project handle</span>
                <input
                  name="handle"
                  placeholder="your-project"
                  minlength="3"
                  maxlength="30"
                  pattern="[a-z0-9][a-z0-9-]{1,28}[a-z0-9]"
                  autocapitalize="none"
                  autocomplete="off"
                  required
                />
                <small>mad.builders/builders/your-handle</small>
              </label>
              <label class="work-field">
                <span>location</span>
                <input name="location" placeholder="Madrid" maxlength="80" autocomplete="address-level2" />
              </label>
              <label class="work-field">
                <span>project</span>
                <input name="projectName" placeholder="What has your attention?" minlength="2" maxlength="100" required />
              </label>
              <label class="work-field">
                <span>project URL</span>
                <input name="projectUrl" type="url" placeholder="https://" inputmode="url" />
              </label>
              <label class="work-field">
                <span>project logo</span>
                <input name="logo" type="file" accept="image/png,image/jpeg,image/webp" aria-describedby="logo-help" />
                <small id="logo-help">We use your website favicon by default. Upload a PNG, JPEG or WebP up to 2 MB to replace it.</small>
              </label>
              <label class="work-field">
                <span>What are you building in a sentence?</span>
                <textarea name="bio" minlength="5" maxlength="280" required></textarea>
              </label>
              <div>
                <button class="work-button" type="submit">publish project</button>
                <p class="work-status" data-form-status aria-live="polite"></p>
              </div>
            </form>
          </>
        ) : unavailableWeek ? (
          <p class="work-copy">This update is unavailable or already published. <a href="/build#this-week">Back to this week</a></p>
        ) : (
          <>
            {buildState?.selectedLateWeek ? (
              <p class="work-note"><a href="/build#this-week">Back to this week</a></p>
            ) : buildState?.unfinishedWeeks.length ? (
              <p class="work-note">Still want to share an earlier week? {buildState.unfinishedWeeks.map((week) => (
                <a href={`/build?week=${week.weekStartDate}#this-week`}>Finish the update for {week.weekStartDate}. </a>
              ))}</p>
            ) : null}
            {buildState?.currentResult && !editing ? (
              <>
                <p class="work-label">published / week of {buildState.currentWeek?.weekStartDate}</p>
                <h2 class="work-heading">Your week is published.</h2>
                <p class="work-copy update-copy">{buildState.currentResult.summary}</p>
                {buildState.nextCommitment && <p class="work-copy">Next week: {buildState.nextCommitment.promise}</p>}
                <p class="work-note">{buildState.phase === 'active' ? `You can edit until voting opens ${madridDate(buildState.currentWeek!.submissionClosesAt)}.` : 'Voting is open. Your update is locked for fair votes.'}</p>
                <div class="work-actions">
                  <ShareButton path={`/builders/${currentProfile.handle}/weeks/${buildState.currentWeek?.weekStartDate}?ref=${currentProfile.handle}`} title={[`Weekly update · week of ${buildState.currentWeek?.weekStartDate}\n\nThis week I worked on ${currentProfile.projectName}:\n${buildState.currentResult.summary}`, buildState.currentResult.feedbackRequest].filter(Boolean).join("\n\n")} expanded={buildState.phase !== 'voting'} eventName="weekly_result_shared" handle={currentProfile.handle} />
                  {buildState.phase === 'active' && <a class="work-button secondary" href="/build?edit#this-week">edit update</a>}
                  {buildState.phase === 'voting' && <a class="work-button" href="/vote">vote on this week</a>}
                  <a
                    class="work-button secondary"
                    href={`/builders/${currentProfile.handle}/weeks/${buildState.currentWeek?.weekStartDate}`}
                  >
                    open the update
                  </a>
                </div>
                {buildState.canSetNextPromise && buildState.nextWeek && (
                  <details class="result-block" data-next-commitment-editor>
                    <summary>Edit next week's goals</summary>
                    <p class="work-note">Goals lock {madridDate(buildState.nextWeek.startsAt)}. Your published update stays unchanged.</p>
                    <form class="work-form" method="post" action="/api/commitment" data-api-form>
                      <input type="hidden" name="projectId" value={currentProfile?.id} />
                      <input type="hidden" name="weekId" value={buildState.nextWeek.id} />
                      <label class="work-field">
                        <span>What do you want to have done by the end of next week?</span>
                        <textarea name="promise" minlength="5" maxlength="280" required>{buildState.nextCommitment?.promise}</textarea>
                      </label>
                      <div>
                        <button class="work-button" type="submit">save next week's goal</button>
                        <p class="work-status" data-form-status aria-live="polite"></p>
                      </div>
                    </form>
                  </details>
                )}
              </>
            ) : votingRequired && review?.state === 'pair' ? (
              <>
                <p class="work-label">{review.reviewed} of {review.total} votes</p>
                <h2 class="work-heading">Finish last week's voting first.</h2>
                <p class="work-copy">Cast your remaining votes before publishing this week's update. Your saved draft will be here when you return.</p>
                <a class="work-button" href="/vote?demo=0">continue voting</a>
                <p class="work-note">Voting closes {madridDate(review.week.votingClosesAt)}.</p>
              </>
            ) : buildState?.currentCommitment || (buildState?.currentWeek && buildState.phase === 'active') ? (
              <>
                <p class="work-label">weekly update / week of {buildState.currentWeek?.weekStartDate}</p>
                <h2 class="work-heading">{editing ? 'Edit your weekly update.' : buildState.currentCommitment?.promise ? 'Tell us how the week went.' : 'Your first weekly update.'}</h2>
                {buildState.currentWeek && (
                  <p class="work-note">{buildState.late ? 'The ranking deadline has passed. You can still publish this update, but it will not enter voting or count toward your streak.' : `Ranking deadline: ${madridDate(buildState.currentWeek.submissionClosesAt)}`}</p>
                )}
                <WeeklyUpdateChat
                  client:load
                  userId={currentUser!.id}
                  projectName={currentProfile.projectName}
                  improveEnabled={Boolean(import.meta.env.CEREBRAS_API_KEY)}
                  projectId={currentProfile.id}
                  draftKey={`weekly:${currentProfile.id}:${buildState.currentWeek?.id}`}
                  commitmentId={buildState.currentCommitment?.id}
                  weekId={buildState.currentWeek?.id}
                  promise={buildState.currentCommitment?.promise}
                  canSetNextPromise={buildState.canSetNextPromise}
                  editing={editing}
                  late={buildState.late}
                  stages={projectStages}
                  initialValues={{
                    projectSentence: buildState.currentResult?.projectSentence ?? currentProfile.bio,
                    summary: buildState.currentResult?.summary ?? '',
                    status: buildState.currentResult?.status ?? '',
                    nextPromise: buildState.nextCommitment?.promise ?? '',
                    feedbackRequest: buildState.currentResult?.feedbackRequest ?? '',
                    projectUrl: currentProfile.projectUrl ?? '',
                    projectStage: currentProfile.projectStage ?? projectStages[0].value,
                    proofUrl: buildState.currentResult?.proofUrl ?? '',
                  }}
                />

              </>
            ) : buildState?.nextWeek ? (
              <>
                <p class="work-label">next week / starts {madridDate(buildState.nextWeek.startsAt)}</p>
                <h2 class="work-heading">What do you want to have done by the end of next week?</h2>
                <p class="work-copy">Set clear goals that another builder can judge as complete or incomplete.</p>
                <form class="work-form" method="post" action="/api/commitment" data-api-form>
                  <input type="hidden" name="projectId" value={currentProfile?.id} />
                  <input type="hidden" name="weekId" value={buildState.nextWeek.id} />
                  <label class="work-field">
                    <span>next week's goals</span>
                    <textarea
                      name="promise"
                      minlength="5"
                      maxlength="280"
                      required
                    >{buildState.nextCommitment?.promise}</textarea>
                  </label>
                  <div>
                    <button class="work-button" type="submit">save next week's goal</button>
                    <p class="work-status" data-form-status aria-live="polite"></p>
                  </div>
                </form>
              </>
            ) : (
              <>
                <p class="work-label">your project is live</p>
                <h2 class="work-heading">Good. Now there's somewhere to put the work.</h2>
                <p class="work-copy">The next weekly cycle has not been scheduled yet. Your project page is ready to share.</p>
                <div class="work-actions">
                  <a class="work-button" href={`/builders/${currentProfile.handle}`}>open my project</a>
                  <a class="work-button secondary" href="/builders">see the projects</a>
                </div>
              </>
            )}
          </>
        )}
        </div>
      </div>
    </section>
  </div>
</ProductLayout>

<script>
  import { attachGithubSignIn } from '../scripts/github-sign-in';
  import { submitApiForm } from '../scripts/submit-api-form';

  attachGithubSignIn();

  document.querySelectorAll<HTMLFormElement>('[data-api-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      await submitApiForm(form);
    });
  });
</script>
