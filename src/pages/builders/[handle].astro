---
import ProductLayout from '../../layouts/ProductLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import ProjectMark from '../../components/ProjectMark.astro';
import { socialPlatforms } from '../../lib/socials';
import { absoluteUrl } from '../../config/seo';
import {
  getProfileByUserId,
  getProjectSocialOwners,
  getPublicProjectActivity,
  getPublicProfileByHandle,
  listPublicResultsByProjectId,
} from '../../server/profiles';
import { finalizeLatestClosedWeek } from '../../server/ranking';

export const prerender = false;
const currentUser = Astro.locals.user;

const handle = Astro.params.handle ?? '';
const abuseEmail = import.meta.env.ABUSE_REPORT_EMAIL;
const builder = await Astro.locals.timing.measure('builder', () => getPublicProfileByHandle(handle));
const socialOwners = builder ? await getProjectSocialOwners(builder.id) : [];
await Astro.locals.timing.measure('finalize', () => finalizeLatestClosedWeek());
const results = builder ? await Astro.locals.timing.measure('results', () => listPublicResultsByProjectId(builder.id)) : [];
const activity = builder ? await Astro.locals.timing.measure('activity', () => getPublicProjectActivity(builder.id)) : null;
const currentProfile = currentUser ? await Astro.locals.timing.measure('profile', () => getProfileByUserId(currentUser.id)) : null;

Astro.response.headers.set('Cache-Control', 'no-store');
if (!builder) Astro.response.status = 404;

const title = builder ? `${builder.projectName.slice(0, 34)} - mad.builders` : 'Project not found - mad.builders';
const description = builder
  ? `${builder.projectName}, built by ${builder.displayName}. Follow its public proof of work.`
  : 'This project page does not exist.';
const profileUrl = builder ? absoluteUrl(`/builders/${builder.handle}`) : undefined;
const structuredData = builder
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: builder.projectName,
      url: profileUrl,
      image: builder.image ?? undefined,
      description: builder.bio || description,
      sameAs: builder.projectUrl ? [builder.projectUrl] : undefined,
    }
  : undefined;
const proofLabel = (status: string) =>
  status === 'github_account_matched'
    ? 'GitHub matched'
    : status === 'proof_linked'
      ? 'proof linked'
      : 'self-reported';
---

<ProductLayout
  title={title}
  description={description}
  image={builder ? `/api/og/builders/${builder.handle}.png` : undefined}
  noindex={!builder}
  active={currentProfile?.handle === builder?.handle ? 'profile' : undefined}
  profileHandle={currentProfile?.handle}
  signedIn={Boolean(currentUser)}
  structuredData={structuredData}
>
  <div class="work-page">
    {builder ? (
      <>
        <header class="work-hero">
          <div class="wrap builder-head">
            <ProjectMark name={builder.projectName} url={builder.projectUrl} logo={builder.logo} />
            <div>
              <p class="work-kicker">project / weekly proof of work</p>
              <h1 class="builder-title">{builder.projectName}</h1>
              <p class="builder-handle mono">by {builder.displayName} · @{builder.handle}{builder.location ? ` · ${builder.location}` : ''}</p>
              {builder.bio && <p class="builder-bio">{builder.bio}</p>}
              {builder.projectUrl && <p class="project-link"><a href={builder.projectUrl} target="_blank" rel="noopener noreferrer nofollow">visit project ↗</a></p>}
              {[{ name: builder.projectName, links: builder.socialLinks }, ...socialOwners].map(owner =>
                Object.keys(owner.links ?? {}).length > 0 && <div class="project-link">
                  <span>{owner.name}: </span>
                  {socialPlatforms.filter(({ key }) => owner.links?.[key]).map(({ key, label }) => <a class="social-link" href={owner.links[key]} target="_blank" rel="noopener noreferrer nofollow">{label} ↗</a>)}
                </div>
              )}
            </div>
          </div>
        </header>

        <section class="wrap work-grid">
          <aside class="work-aside">
            <p class="work-label">shipping streak</p>
            <p class="profile-name">{activity?.streak ?? 0} {(activity?.streak ?? 0) === 1 ? 'week' : 'weeks'}</p>
            <p class="work-note">Complete or partial updates published on time keep the streak alive.</p>
            {abuseEmail && <p class="work-note"><a href={`mailto:${abuseEmail}?subject=Report%20builder%20%40${builder.handle}`}>report abuse</a></p>}
          </aside>
          <div class="work-main">
            <p class="work-label">weekly updates</p>
            <h2 class="work-heading">{results.length ? `${results.length} public ${results.length === 1 ? 'update' : 'updates'}.` : 'No updates yet.'}</h2>
            {results.length > 0 && <p class="work-copy">Each update is tied to the goal set before it.</p>}
            {activity?.commitment?.promise && (
              <div class="result-block">
                <p class="work-label">
                  {activity.commitment.startsAt > activity.now ? 'next goal' : 'this week\u2019s goal'} / week of {activity.commitment.weekStartDate}
                </p>
                <p class="builder-bio">{activity.commitment.promise}</p>
              </div>
            )}
            {currentProfile?.handle === builder.handle && (
              <div class="work-actions">
                <a class="work-button" href="/build#this-week">write your update</a>
                <a class="work-button secondary" href="/settings">edit project</a>
                <ShareButton
                  path={`/builders/${builder.handle}${results[0] ? `/weeks/${results[0].weekStartDate}` : ""}?ref=${builder.handle}`}
                  title={[results[0] ? `Weekly update · week of ${results[0].weekStartDate}\n\nHere’s what I’ve been working on ${builder.projectName}:\n${results[0].summary}` : `${builder.projectName}, built by ${builder.displayName}.\n${builder.bio || ""}`, results[0]?.feedbackRequest].filter(Boolean).join("\n\n")}
                  eventName={results[0] ? "weekly_result_shared" : "builder_profile_shared"}
                  handle={builder.handle}
                />
              </div>
            )}
            {results.length ? (
              <div class="result-list">
                {results.map((published) => (
                  <a class="result-row" href={`/builders/${builder.handle}/weeks/${published.weekStartDate}`}>
                    <span class="result-week">week of {published.weekStartDate}</span>
                    <span>
                      {published.promise && <span class="result-promise">{published.promise}</span>}
                      <span class="result-summary">{published.summary}</span>
                    </span>
                    <span class="result-meta">
                      {published.rank
                        ? <strong class="result-rank">#{published.rank}</strong>
                        : <span>{!published.onTime ? 'late' : published.weekFinalizedAt ? 'unranked' : 'awaiting rank'}</span>}
                      <span>{proofLabel(published.proofStatus)}</span>
                    </span>
                  </a>
                ))}
              </div>
            ) : null}
          </div>
        </section>
      </>
    ) : (
      <section class="work-hero">
        <div class="wrap">
          <p class="work-kicker">404 / project not found</p>
          <h1 class="work-title">Nothing here yet.</h1>
          <p class="work-intro">The handle may be wrong, or the project has been taken down.</p>
          <p><a class="work-button" href="/builders">see all projects</a></p>
        </div>
      </section>
    )}
  </div>
</ProductLayout>

<style>
  .social-link { display: inline-block; margin-inline-end: 1rem; }
</style>
