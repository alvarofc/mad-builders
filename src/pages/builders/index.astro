---
import ProductLayout from '../../layouts/ProductLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { PAGE_SIZE, pageNumber } from '../../server/pagination';
import ProjectMark from '../../components/ProjectMark.astro';
import { getProfileByUserId, listPublicProfiles } from '../../server/profiles';

export const prerender = false;
const currentUser = Astro.locals.user;

const page = pageNumber(Astro.url.searchParams.get('page'));
const rows = await Astro.locals.timing.measure('projects', () => listPublicProfiles(page));
const profiles = rows.slice(0, PAGE_SIZE);
const currentProfile = currentUser ? await Astro.locals.timing.measure('profile', () => getProfileByUserId(currentUser.id)) : null;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<ProductLayout
  title="Projects - mad.builders"
  description="Projects building in public from Madrid. Each one publishes what it shipped every week, and the community votes on the leaderboard."
  active="builders"
  profileHandle={currentProfile?.handle}
  signedIn={Boolean(currentUser)}
>
  <div class="work-page">
    <header class="work-hero">
      <div class="wrap">
        <p class="work-kicker">building in public</p>
        <h1 class="work-title">Projects</h1>
        <p class="work-intro">Every project here publishes what it shipped, week after week. <a href="/leaderboard">See this week's ranks</a>.</p>
      </div>
    </header>

    <section class="section">
      <div class="wrap">
        {profiles.length ? (
          <div class="profile-list">
            {profiles.map((profile) => (
              <a class="profile-row" href={`/builders/${profile.handle}`}>
                <ProjectMark name={profile.projectName} url={profile.projectUrl} logo={profile.logo} />
                <span class="profile-name">{profile.projectName}</span>
                <span class="profile-project">by {profile.displayName} · @{profile.handle}</span>
                <span class="profile-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-ledger">
            <h2 class="work-heading">{page > 1 ? 'No projects on this page.' : 'The first page is still blank.'}</h2>
            <p class="work-copy">{page > 1 ? 'The list ends before this page.' : 'Put your project on it.'}</p>
            <a class="work-button" href={page > 1 ? '/builders' : '/build'}>{page > 1 ? 'back to the first page' : 'add your project'}</a>
          </div>
        )}
        <Pagination page={page} hasNext={rows.length > PAGE_SIZE} />
      </div>
    </section>
  </div>
</ProductLayout>
