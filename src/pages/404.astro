---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title="Page not found - mad.builders" description="This page doesn't exist." noindex={true}>
  <section class="section notfound">
    <div class="wrap">
      <p class="kicker">error 404</p>
      <h1 class="section-title">Page not found</h1>
      <p class="lede">
        This page doesn't exist. Head home to find the entrepreneurs building here.
      </p>
      <div class="actions">
        <a class="btn solid" href="/">← home</a>
        <a class="btn" href={site.whatsapp} target="_blank" rel="noopener">whatsapp group →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
</style>
