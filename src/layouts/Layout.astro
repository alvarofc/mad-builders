---
import '../styles/global.css';
// Self-hosted fonts (same-origin, no render-blocking Google Fonts chain).
// Only the weights actually used: Archivo 400/500/600/700, IBM Plex Mono 400/500,
// and the Bricolage Grotesque variable face for the wordmark.
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { DEFAULT_TITLE } from '../config/seo';
import SEO from '../components/SEO.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  signedIn?: boolean;
  product?: boolean;
  structuredData?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = DEFAULT_TITLE,
  description = site.description,
  image,
  noindex,
  signedIn = false,
  product = false,
  structuredData,
} = Astro.props;

const socialIcons = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/socials/*.svg', { eager: true });
const iconFor = (icon: string) => socialIcons[`../assets/logos/socials/${icon}.svg`]?.default;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} noindex={noindex} structuredData={structuredData} />
  </head>
  <body>
    {!product && <header class="nav">
      <div class="wrap nav-inner">
        <a href="/" class="wordmark" data-brand-menu-trigger aria-haspopup="menu">mad<span>.builders</span></a>
        <nav class="links mono">
          <a href="/madrid" class="nav-secondary">Madrid</a>
          <a href="/builders" class="nav-projects">Projects</a>
          <a href={site.whatsapp} class="nav-secondary">WhatsApp</a>
          <a href="/leaderboard" class="cta">rankings →</a>
          {!signedIn && <>
            <a href="/build#this-week" class="login-button" hidden>log in</a>
            <noscript><a href="/build#this-week" class="login-button">log in</a></noscript>
          </>}
        </nav>
      </div>
    </header>}

    <main class="site-main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-top">
        <div class="footer-brand">
          <a href="/" class="footer-mark" data-brand-menu-trigger aria-haspopup="menu">mad<span>.builders</span></a>
          <a class="footer-map mono" href="https://maps.app.goo.gl/3MxVbkH5V8UQwMMu6" target="_blank" rel="noopener">pl. del callao 1<br />Madrid, Spain ↗</a>
        </div>
        <nav class="footer-nav mono" aria-label="footer">
          <a href="/brand">brand</a>
        </nav>
      </div>
      <div class="wrap footer-bar mono">
        <span>est. 2025 · mad.builders</span>
        <div class="socials">
          {site.socials.map((s) => {
            const icon = iconFor(s.icon);
            if (!icon) return null;
            const img = <img src={icon.src} alt={s.label} title={s.label} />;
            return s.url ? (
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}>{img}</a>
            ) : (
              img
            );
          })}
        </div>
      </div>
    </footer>
    <div id="brand-menu" class="brand-menu mono" popover="manual" role="menu">
      <p>media assets</p>
      <a href="/brand#assets" role="menuitem">all assets <span>→</span></a>
      <a href="/logo/mad-builders-cream.svg" download role="menuitem">logo · svg <span>↓</span></a>
      <a href="/logo/mad-builders-cream.png" download role="menuitem">logo · png <span>↓</span></a>
    </div>
    {!Astro.url.searchParams.has('invite') && <Analytics />}

    <script is:inline>
      const loginButton = document.querySelector('.login-button');
      if (loginButton) {
        const refreshLoginButton = async () => {
          let signedIn = false;
          try {
            const response = await fetch('/api/auth/get-session', { cache: 'no-store' });
            if (response.ok) {
              const session = await response.json();
              signedIn = Boolean(session?.user);
            }
          } catch {
            // Keep the login link available when the session service is unreachable.
          } finally {
            loginButton.hidden = signedIn;
          }
        };
        void refreshLoginButton();
        window.addEventListener('pageshow', (event) => {
          if (event.persisted) void refreshLoginButton();
        });
      }
    </script>

    <script>
      const brandMenu = document.querySelector<HTMLElement>('#brand-menu');

      document.querySelectorAll<HTMLElement>('[data-brand-menu-trigger]').forEach((wordmark) => {
        wordmark.addEventListener('contextmenu', (event) => {
          if (!brandMenu) return;

          event.preventDefault();
          const mark = wordmark.getBoundingClientRect();
          const x = event.clientX || mark.left;
          const y = event.clientY || mark.bottom;
          brandMenu.style.left = `${Math.max(12, Math.min(x, window.innerWidth - 252))}px`;
          brandMenu.style.top = `${Math.max(12, Math.min(y, window.innerHeight - 156))}px`;

          if (!brandMenu.matches(':popover-open')) brandMenu.showPopover();
        });
      });

      brandMenu?.addEventListener('click', () => brandMenu.hidePopover());
      document.addEventListener('pointerdown', (event) => {
        if (brandMenu?.matches(':popover-open') && !brandMenu.contains(event.target as Node)) {
          brandMenu.hidePopover();
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && brandMenu?.matches(':popover-open')) brandMenu.hidePopover();
      });
    </script>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: color-mix(in srgb, var(--green) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .wordmark span {
    color: var(--cream-dim);
    font-weight: 400;
  }
  .brand-menu {
    position: fixed;
    inset: auto;
    width: min(240px, calc(100vw - 24px));
    margin: 0;
    padding: 6px;
    color: var(--green);
    background: var(--cream);
    border: 1px solid color-mix(in srgb, var(--green) 22%, transparent);
    border-radius: 8px;
    box-shadow: 0 18px 50px rgba(20, 42, 34, 0.24);
  }
  .brand-menu p {
    margin: 8px 10px 6px;
    color: color-mix(in srgb, var(--green) 50%, transparent);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .brand-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 10px;
    border-radius: 4px;
    color: var(--green);
    text-decoration: none;
  }
  .brand-menu a:hover,
  .brand-menu a:focus-visible {
    color: var(--cream);
    background: var(--green);
    outline: none;
  }
  .links {
    display: flex;
    gap: 26px;
    align-items: center;
  }
  .links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
    color: var(--cream-dim);
    transition: color 0.15s;
  }
  .links a:hover {
    color: var(--cream);
  }
  .links .cta {
    color: var(--cream);
    border: 1px solid var(--line);
    padding: 8px 16px;
    border-radius: 999px;
  }
  .links .cta:hover {
    background: var(--cream);
    color: var(--green);
  }
  .links .login-button {
    padding: 8px 16px;
    border: 1px solid var(--cream);
    border-radius: 999px;
    color: var(--green);
    background: var(--cream);
  }
  .links .login-button:hover {
    color: var(--cream);
    background: transparent;
  }
  .links .login-button[hidden] {
    display: none;
  }
  @media (max-width: 640px) {
    .links {
      gap: 12px;
      font-size: 12px;
    }
    .wordmark {
      white-space: nowrap;
    }
    .links .nav-secondary {
      display: none;
    }
    .links .cta,
    .links .login-button {
      padding: 7px 10px;
    }
  }
  @media (max-width: 460px) {
    .links .nav-projects {
      display: none;
    }
  }

  .footer {
    border-top: 1px solid var(--line);
    padding: 56px 0 28px;
    background: var(--green-deep);
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    padding-bottom: 38px;
  }
  .footer-mark {
    display: block;
    line-height: 1;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--cream);
  }
  .footer-mark span {
    color: var(--cream-dim);
    font-weight: 400;
  }
  .footer-map {
    display: block;
    margin-top: 12px;
    color: var(--cream-faint);
    text-decoration: none;
    font-size: 12px;
    line-height: 1.7;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .footer-map:hover {
    color: var(--cream);
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .footer-nav a {
    color: var(--cream-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-nav a:hover {
    color: var(--cream);
  }
  .footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    color: var(--cream-faint);
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .socials {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .socials img {
    height: 18px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.6;
    transition: opacity 0.15s;
  }
  .socials img:hover {
    opacity: 1;
  }
  @media (max-width: 640px) {
    .footer-bar {
      justify-content: center;
      text-align: center;
    }
  }
</style>
